<?xml version="1.0" encoding="UTF-8"?>
<!--
========================================================================
GUIA 8 - ACTIVIDAD 2: VALIDACION ESTRUCTURAL DEL PROTOCOLO
Este esquema XSD define las reglas minimas que deben cumplir los mensajes XML.
========================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="appointmentMessage">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="header">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="type">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="request"/>
                                        <xs:enumeration value="response"/>
                                        <xs:enumeration value="error"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="operation" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="body">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:any minOccurs="1" maxOccurs="unbounded" processContents="lax"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
